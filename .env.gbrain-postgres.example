# Copy to .env.gbrain-postgres (mode 0600) and fill in a strong random value.
# Consumed only by the gbrain-postgres service in docker-compose.yml.
#
#   umask 077 && printf 'POSTGRES_PASSWORD=%s\n' \
#     "$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40)" > .env.gbrain-postgres
#
# Alphanumeric on purpose: the value goes into GBRAIN_DATABASE_URL verbatim,
# so it must need no percent-encoding.
POSTGRES_PASSWORD=
