# Pinned tool manifest for the image build (single source of truth).
#
# Consumed by every Dockerfile stage: `pins` splits it into /monolith.env and
# /pg.env (cache-key isolation), `tools` and the final smoke source it whole,
# `monolith-build` and the apt/PGDG RUN source the split-out subsets. Shipped
# verbatim at /etc/baked-tools.env so an operator can `cat` the pins on a live box.
# Deliberately a plain file, NOT Dockerfile ARGs: Render translates every
# service env var into a `--build-arg`, so an ARG default would be a
# dashboard-overridable pin. Format: KEY=value, no quotes, shell-sourceable.
#
# Bumping a pin: edit the value(s) here, run `npm test` + `npm run test:e2e`,
# record the bump in CHANGELOG.md + VERSION (same discipline as the alphaclaw
# SHA and the claude-code pin). Checksums come from the upstream release
# checksum files (Caddy: caddy_<ver>_checksums.txt is SHA-512; Bun:
# SHASUMS256.txt; Tailscale: the .sha256 sidecars on pkgs.tailscale.com).

# Caddy — static Go binary from the GitHub release (SHA-512 per upstream checksums.txt)
CADDY_VERSION=2.11.4
CADDY_SHA512_AMD64=8220d1f013b6f27510247b2360c9e0ca9f018feebd82515f07635318b34ff9777ccc8fd0b6e6f2486ce3a33fe389fbb7db12d05baa474f4587509fb4f5ebf1c9
CADDY_SHA512_ARM64=d5a7c423853c24a799765e0e8210d5c7c22a8f56ed37a3cae2fb9f58be138853c02b4efd6b59d576e6d8c7c0d30b9c1592deeaa6a536ff69bcca23b8c1ea709c

# Tailscale — static Go binaries (tailscale + tailscaled) from pkgs.tailscale.com/stable
TAILSCALE_VERSION=1.102.3
TAILSCALE_SHA256_AMD64=36ddd9b51be57ffc2990cf76323cfa13643bfbb1b8a969f6183fa164741cdef5
TAILSCALE_SHA256_ARM64=a0fa1b154af8c61f862a2259f559f7396d96c0225f4a863eae2333e1546bbe25

# Bun — GitHub release zips (SHA-256 per upstream SHASUMS256.txt); requires glibc >= 2.17 (bookworm ships 2.36)
BUN_VERSION=1.4.2
BUN_SHA256_X64=36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913
BUN_SHA256_AARCH64=54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7

# monolith — built from source at the git commit of tag v<MONOLITH_VERSION>
# (the upstream aarch64 prebuilt links libssl1.1, absent from Debian bookworm).
MONOLITH_VERSION=2.10.1
MONOLITH_REV=47affd5f9070eb01a94045ce31923e577f9a9162

# PostgreSQL client major (PGDG signed apt repo; the minor floats inside the repo)
PG_MAJOR=17

# agy — the Antigravity CLI (Gemini family), the executor described in the
# workspace note docs/ops/ai-providers/agy-usage.md. The vendor's documented
# install is `curl -fsSL https://antigravity.google/cli/install.sh | bash`,
# which resolves a moving per-platform manifest and pipes into a shell — both
# unpinnable and forbidden here (no pipe-to-shell; contract-tested). AGY_BUILD
# is the immutable release path segment out of that manifest, and AGY_SHA512_*
# are the vendor's own published digests of the same two artifacts, so the
# tools stage fetches exactly what the installer would have fetched and
# verifies it the way Caddy and Bun are verified. Re-read the manifest when
# bumping (one per arch):
#   .../manifests/linux_amd64.json and .../manifests/linux_arm64.json on
#   https://antigravity-cli-auto-updater-974169037036.us-central1.run.app
# The tarball holds a single file named `antigravity`; the vendor installer
# renames it to `agy` on disk, and so does the tools stage.
AGY_VERSION=1.2.2
AGY_BUILD=1.2.2-6061403484848128
AGY_SHA512_AMD64=74342cf2a78b344392e573b638a648a6ad1f8e877f494b96e20f9c2b79158d5c423c40b2dcf788703362bb0a9150f09c707fde599d7557ce01c12208802a63cb
AGY_SHA512_ARM64=a1645a30f36b767c7534c2f6a53e99a9bfade993267efcca715f7a45d797d47d6561df787e9d4a51a3bdfc9be855d49d23fa3f4b91b2c661fd17314050836048
